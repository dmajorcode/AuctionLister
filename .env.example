# 이 파일을 .env 로 복사해서 값을 넣으세요. (.env 는 git 에 올라가지 않습니다)
# GitHub 에서 돌릴 때는 같은 이름으로 Settings > Secrets and variables > Actions 에 등록합니다.

# 텔레그램 봇 토큰 (@BotFather → @AuctionCrawlerBot)
TELEGRAM_TOKEN=
# 알림 받을 사람 채팅 ID, 쉼표로 여러 명 (python3 telegram_setup.py 로 확인)
TELEGRAM_CHAT_IDS=
# 국토부 아파트 매매 실거래가 API 키 (같은 평형 시세, 선택)
MOLIT_API_KEY=
# 선순위임차인/임차권등기/선순위가등기/유치권 물건도 알림에 포함하려면 (선택)
# ALERT_SHOW_TAGS=선순위임차인,임차권등기,선순위가등기,유치권
# 공유 링크 키 (20자 이상 무작위 문자열)
BOARD_KEY=
